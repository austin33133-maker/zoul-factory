.loading { padding: 40rpx; display: flex; align-items: center; justify-content: center; color: var(--color-text-tertiary); font-size: 24rpx; }
.loading .spinner {
  width: 32rpx; height: 32rpx;
  border: 4rpx solid var(--color-border);
  border-top-color: var(--color-primary);
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
  margin-right: 12rpx;
}
@keyframes spin { to { transform: rotate(360deg); } }
