.counter { display: inline-flex; align-items: center; border: 2rpx solid var(--color-border); border-radius: 8rpx; overflow: hidden; }
.counter .btn { width: 56rpx; height: 56rpx; display: flex; align-items: center; justify-content: center; font-size: 32rpx; color: #333; background: #fafafa; }
.counter .btn.disabled { color: #ccc; }
.counter .num { width: 72rpx; text-align: center; font-size: 28rpx; }
