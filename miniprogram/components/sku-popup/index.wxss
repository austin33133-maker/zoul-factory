.mask { position: fixed; inset: 0; background: rgba(0,0,0,0.5); display: none; z-index: 999; }
.mask.show { display: block; }
.sheet { position: absolute; left: 0; right: 0; bottom: 0; background: #fff; border-radius: 24rpx 24rpx 0 0; max-height: 80vh; display: flex; flex-direction: column; }
.head { display: flex; padding: 24rpx; border-bottom: 2rpx solid var(--color-border); position: relative; }
.head .cover { width: 180rpx; height: 180rpx; border-radius: 16rpx; margin-top: -60rpx; background: #eee; }
.head .meta { padding-left: 20rpx; padding-top: 8rpx; }
.head .close { position: absolute; right: 20rpx; top: 12rpx; font-size: 48rpx; color: #999; line-height: 1; }
.body { padding: 0 24rpx; flex: 1; max-height: 50vh; }
.spec-group { padding: 20rpx 0; }
.spec-name { font-size: 28rpx; font-weight: 600; margin-bottom: 16rpx; }
.spec-values { display: flex; flex-wrap: wrap; }
.spec-val { padding: 12rpx 28rpx; border: 2rpx solid var(--color-border); border-radius: 999rpx; font-size: 26rpx; margin: 0 16rpx 16rpx 0; color: #333; background: #fafafa; }
.spec-val.active { background: var(--color-primary-light); border-color: var(--color-primary); color: var(--color-primary); }
.count-row { padding: 24rpx 0; border-top: 2rpx solid var(--color-border); }
.actions { display: flex; padding: 16rpx 24rpx; gap: 16rpx; }
.actions .btn-cart, .actions .btn-buy { flex: 1; height: 80rpx; border-radius: 999rpx; display: flex; align-items: center; justify-content: center; color: #fff; font-size: 28rpx; }
.actions .btn-cart { background: #ffa726; }
.actions .btn-buy { background: var(--color-primary); }
.actions .btn-buy.full { width: 100%; }
