<view class="coupons">
  <view wx:if="{{list.length}}" class="list">
    <view wx:for="{{list}}" wx:key="id" class="coupon">
      <view class="left">
        <view class="amount">¥<text class="num">{{amountYuan}}</text></view>
        <view class="threshold">{{thresholdYuan ? '满 ' + thresholdYuan + ' 可用' : '无门槛'}}</view>
      </view>
      <view class="right">
        <view class="name">{{item.name}}</view>
        <view class="expire">有效期至 {{item.expireText}}</view>
      </view>
    </view>
  </view>
  <empty wx:else text="暂无优惠券" icon="🎟️" />
</view>
