.order-list { padding-bottom: 40rpx; }
.tabs { display: flex; background: #fff; position: sticky; top: 0; z-index: 10; border-bottom: 2rpx solid var(--color-border); }
.tab { flex: 1; text-align: center; padding: 24rpx 0; font-size: 26rpx; color: #555; position: relative; }
.tab.active { color: var(--color-primary); font-weight: 600; }
.tab.active::after { content: ''; position: absolute; bottom: 0; left: 50%; transform: translateX(-50%); width: 48rpx; height: 4rpx; background: var(--color-primary); }

.list { padding: 16rpx; display: flex; flex-direction: column; gap: 16rpx; }
.order-card .head { padding: 20rpx 24rpx; border-bottom: 2rpx solid var(--color-border); font-size: 24rpx; color: #888; }
.order-card .head .status { color: var(--color-primary); }
.order-card .goods { padding: 16rpx 24rpx; }
.order-card .goods-item { display: flex; padding: 12rpx 0; }
.order-card .cover { width: 120rpx; height: 120rpx; border-radius: 12rpx; background: #eee; }
.order-card .meta { padding: 0 16rpx; }
.order-card .title { font-size: 26rpx; }
.order-card .spec { font-size: 22rpx; color: #999; padding: 4rpx 8rpx; background: #f3f3f3; border-radius: 6rpx; display: inline-block; margin-top: 6rpx; }
.order-card .right { text-align: right; }
.order-card .count { font-size: 24rpx; color: #999; }
.order-card .foot { padding: 16rpx 24rpx; border-top: 2rpx solid var(--color-border); }
.order-card .amount { display: flex; align-items: center; gap: 8rpx; font-size: 26rpx; }
.order-card .ops { display: flex; justify-content: flex-end; gap: 16rpx; padding: 16rpx 24rpx 20rpx; }
.order-card .op { padding: 12rpx 28rpx; border: 2rpx solid #ddd; border-radius: 999rpx; font-size: 24rpx; color: #555; }
.order-card .op.primary { border-color: var(--color-primary); color: var(--color-primary); }
