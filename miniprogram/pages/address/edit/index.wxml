<view class="edit">
  <view class="card">
    <view class="row">
      <text class="label">收货人</text>
      <input class="input" placeholder="姓名" data-key="name" value="{{form.name}}" bindinput="setField" />
    </view>
    <view class="row">
      <text class="label">手机号</text>
      <input class="input" type="number" maxlength="11" placeholder="请输入手机号" data-key="phone" value="{{form.phone}}" bindinput="setField" />
    </view>
    <view class="row col">
      <text class="label">详细地址</text>
      <textarea class="textarea" placeholder="街道/小区/楼栋/门牌号" data-key="detail" value="{{form.detail}}" bindinput="setField" />
    </view>
    <view class="row" bindtap="toggleDefault">
      <text class="label">设为默认地址</text>
      <text class="flex-1 text-right">{{form.isDefault ? '✅' : '⬜'}}</text>
    </view>
  </view>

  <view class="bar safe-bottom">
    <view class="btn-primary" bindtap="save">保存</view>
  </view>
</view>
