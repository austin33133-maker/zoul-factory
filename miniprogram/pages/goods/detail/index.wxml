<loading wx:if="{{loading}}" />

<view wx:if="{{goods}}" class="detail">
  <swiper class="gallery" indicator-dots="true" autoplay="false" circular="true">
    <swiper-item wx:for="{{goods.images}}" wx:key="*this">
      <image class="g-img" src="{{item}}" mode="aspectFill" data-url="{{item}}" bindtap="previewImg"></image>
    </swiper-item>
  </swiper>

  <view class="info card">
    <view class="price-row flex-between">
      <price value="{{goods.price}}" size="lg" />
      <text class="origin">¥{{goods.originalPrice / 100}}</text>
    </view>
    <view class="title">{{goods.title}}</view>
    <view class="subtitle">{{goods.subtitle}}</view>
    <view class="meta flex-between">
      <text class="text-tertiary text-sm">销量 {{goods.sales}} · 库存 {{goods.stock}} · ★ {{goods.rating}}</text>
    </view>
    <view class="tags">
      <text wx:for="{{goods.tags}}" wx:key="*this" class="tag">{{item}}</text>
    </view>
  </view>

  <view class="block card" data-action="cart" bindtap="openSku">
    <view class="block-row flex-between">
      <text class="text-secondary">已选</text>
      <text class="ellipsis flex-1 text-right">请选择规格</text>
      <text class="arrow">›</text>
    </view>
  </view>

  <view class="block card">
    <view class="block-title">商品介绍</view>
    <view class="desc">{{goods.description}}</view>
    <image wx:for="{{goods.images}}" wx:key="*this" class="desc-img" src="{{item}}" mode="widthFix"></image>
  </view>

  <view class="bottom-bar safe-bottom">
    <view class="bb-icon" bindtap="goHome">
      <text>🏠</text>
      <text class="bb-label">首页</text>
    </view>
    <view class="bb-icon" bindtap="toggleFav">
      <text>{{favorited ? '❤️' : '🤍'}}</text>
      <text class="bb-label">收藏</text>
    </view>
    <view class="bb-icon" bindtap="goCart">
      <text>🛒</text>
      <text class="bb-label">购物车</text>
      <text wx:if="{{cartCount}}" class="badge">{{cartCount}}</text>
    </view>
    <view class="bb-cart" data-action="cart" bindtap="openSku">加入购物车</view>
    <view class="bb-buy" data-action="buy" bindtap="openSku">立即购买</view>
  </view>
</view>

<sku-popup
  show="{{skuShow}}"
  goods="{{goods}}"
  mode="{{skuMode}}"
  bind:close="closeSku"
  bind:confirm="onSkuConfirm"
/>
