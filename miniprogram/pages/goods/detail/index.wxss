.detail { padding-bottom: 140rpx; }
.gallery { width: 100%; height: 750rpx; background: #eee; }
.gallery .g-img { width: 100%; height: 100%; }

.info { margin: 16rpx; padding: 24rpx; }
.info .price-row { align-items: flex-end; }
.info .origin { color: #aaa; text-decoration: line-through; font-size: 24rpx; margin-left: 16rpx; }
.info .title { font-size: 32rpx; font-weight: 600; margin: 16rpx 0 8rpx; }
.info .subtitle { color: var(--color-text-secondary); font-size: 26rpx; }
.info .meta { margin-top: 16rpx; }
.info .tags { margin-top: 12rpx; }

.block { margin: 16rpx; padding: 24rpx; }
.block .block-title { font-size: 28rpx; font-weight: 600; margin-bottom: 16rpx; }
.block .desc { color: #555; font-size: 26rpx; line-height: 1.6; }
.block .desc-img { width: 100%; margin-top: 16rpx; border-radius: var(--radius-md); }

.block-row { font-size: 26rpx; }
.block-row .arrow { color: #ccc; margin-left: 12rpx; }

.bottom-bar { position: fixed; left: 0; right: 0; bottom: 0; background: #fff; border-top: 2rpx solid var(--color-border); display: flex; align-items: center; padding: 12rpx 16rpx; }
.bb-icon { display: flex; flex-direction: column; align-items: center; padding: 0 16rpx; font-size: 32rpx; position: relative; }
.bb-icon .bb-label { font-size: 20rpx; color: #999; }
.bb-icon .badge { position: absolute; top: -8rpx; right: 0; background: var(--color-primary); color: #fff; font-size: 18rpx; min-width: 30rpx; height: 30rpx; line-height: 30rpx; padding: 0 6rpx; border-radius: 999rpx; }
.bb-cart, .bb-buy { flex: 1; height: 80rpx; display: flex; align-items: center; justify-content: center; color: #fff; font-size: 28rpx; }
.bb-cart { background: #ffa726; border-radius: 999rpx 0 0 999rpx; }
.bb-buy { background: var(--color-primary); border-radius: 0 999rpx 999rpx 0; }
