# Get these from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxx

# Created automatically when you set up a webhook endpoint in Stripe dashboard
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Public URL where this server is reachable (no trailing slash)
# Local dev: http://localhost:3000
# Prod:      https://your-app.onrender.com
PUBLIC_URL=http://localhost:3000

# Random long string. Used to sign download tokens so links can't be forged.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DOWNLOAD_SIGNING_SECRET=change-me-to-a-long-random-string

# Currency for all products (lowercase ISO code: usd, eur, cny, hkd, etc.)
CURRENCY=usd

PORT=3000
